{
  "name": "chatgpt-agent-delegation-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stateless MCP delegation bridge: ChatGPT remains the primary brain and explicitly invokes specialist AI only when needed.",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@openai/agents": "0.13.5",
    "@openai/codex-sdk": "0.128.0",
    "express": "5.1.0",
    "zod": "4.0.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}
