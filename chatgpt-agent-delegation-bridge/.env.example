# ChatGPT remains the primary brain. This service exposes specialist delegation and bounded local tools only.
NODE_ENV=development
MCP_BIND=127.0.0.1
MCP_PORT=3210
MCP_PATH=/mcp
MCP_ALLOWED_HOSTS=127.0.0.1,localhost

# Development may use none on localhost only. Production must use authenticated access.
MCP_AUTH_MODE=none
MCP_AUTH_TOKEN=

MAX_REQUEST_BYTES=1048576
MAX_OUTPUT_BYTES=1048576
DEFAULT_TIMEOUT_SECONDS=300
DELEGATION_OWNER_ID=danganhdung
WORKSPACE_REGISTRY_PATH=./config/workspaces.json

# Codex is an AI specialist and uses the user's existing local Codex authentication.
CODEX_ENABLED=true
CODEX_MODEL=
CODEX_REASONING_EFFORT=high
CODEX_NETWORK_ACCESS=false

# Local executor is not an AI. It performs bounded allowlisted host operations.
LOCAL_EXECUTOR_ENABLED=false

# Agents SDK specialist is optional and disabled until a model/provider is explicitly approved.
SPECIALIST_AGENT_ENABLED=false
SPECIALIST_MODEL=
SPECIALIST_BASE_URL=https://api.openai.com/v1
SPECIALIST_API_KEY=
SPECIALIST_USE_RESPONSES=true
SPECIALIST_MAX_TURNS=6
