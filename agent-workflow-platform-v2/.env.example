# Copy to .env locally. Never commit real values.
NODE_ENV=development
PORT=3100
LOG_LEVEL=info
WORKER_CONCURRENCY=2

OPENAI_API_KEY=
OPENAI_MANAGER_MODEL=
OPENAI_SPECIALIST_MODEL=
OPENAI_AGENTS_DISABLE_TRACING=1
AGENT_MAX_TURNS=12

# Gemini Developer API. Google AI Pro subscription does not replace API credentials/billing.
GOOGLE_API_KEY=
GEMINI_MODEL=
GEMINI_API_VERSION=v1

# NotebookLM currently runs as a source-package handoff workflow.
NOTEBOOKLM_SOURCE_PACKAGE_ONLY=true

# Canva uses a separately deployed OAuth/Connect API or MCP adapter.
CANVA_ADAPTER_URL=
CANVA_ACCESS_TOKEN=

POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://agent_v2:replace-with-a-long-random-password@localhost:5432/agent_v2
REDIS_URL=redis://localhost:6379
QUEUE_NAME=agent-workflow-v2

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-with-access-key
MINIO_SECRET_KEY=replace-with-a-long-random-secret
MINIO_BUCKET=agent-v2-evidence

API_AUTH_TOKEN=replace-with-a-long-random-api-token
HERMES_ADAPTER_URL=
CODEX_ADAPTER_URL=
CLAUDE_ADAPTER_URL=
ADAPTER_AUTH_TOKEN=replace-with-a-long-random-adapter-token

AGENT_V2_API_PORT=3100
