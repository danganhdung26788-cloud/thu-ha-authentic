# Copy to .env locally. Never commit real values.
NODE_ENV=development
PORT=3100
LOG_LEVEL=info
WORKER_CONCURRENCY=2

# Default Manager/Specialist provider: local Ollama, no external API billing.
MODEL_PROVIDER=ollama
MODEL_BASE_URL=http://ollama:11434/v1
MODEL_API_KEY=ollama-local
MANAGER_MODEL=qwen3:4b
SPECIALIST_MODEL=qwen3:4b
MODEL_USE_RESPONSES=false
MODEL_REQUEST_TIMEOUT_MS=90000
OPENAI_API_KEY=
OPENAI_MANAGER_MODEL=
OPENAI_SPECIALIST_MODEL=
OPENAI_AGENTS_DISABLE_TRACING=1
AGENT_MAX_TURNS=12

# Hidden technical identity for the single-user local chat app.
DEFAULT_OWNER_ID=danganhdung
DEFAULT_WORKSPACE_ID=workflow-v2-sandbox
CHAT_SESSION_TTL_SECONDS=86400
CHAT_ATTACHMENT_ROOT=/workspace/chat-attachments
CHAT_ATTACHMENT_SCOPE_ROOT=runtime/chat-attachments
CHAT_MAX_ATTACHMENT_BYTES=26214400
CHAT_MAX_DIAGNOSTIC_BYTES=20480

# Required local attachment malware scan. No external scanning service is used.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000
CLAMAV_REQUIRED=true
RUNTIME_GIT_COMMIT=unknown

# Gemini Developer API remains disabled until separately approved.
GOOGLE_API_KEY=
GEMINI_MODEL=
GEMINI_API_VERSION=v1

# NotebookLM currently runs as a source-package handoff workflow.
NOTEBOOKLM_SOURCE_PACKAGE_ONLY=true

# Canva uses a separately deployed OAuth/Connect API or MCP adapter.
CANVA_ADAPTER_URL=
CANVA_ACCESS_TOKEN=

POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://agent_v2:replace-with-a-long-random-password@localhost:5432/agent_v2
REDIS_URL=redis://localhost:6379
QUEUE_NAME=agent-workflow-v2

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-with-access-key
MINIO_SECRET_KEY=replace-with-a-long-random-secret
MINIO_BUCKET=agent-v2-evidence

API_AUTH_TOKEN=replace-with-a-long-random-api-token
HERMES_ADAPTER_URL=
CODEX_ADAPTER_URL=
CLAUDE_ADAPTER_URL=
ADAPTER_AUTH_TOKEN=replace-with-a-long-random-adapter-token

AGENT_V2_API_PORT=3100
OLLAMA_MODEL=qwen3:4b
OLLAMA_KEEP_ALIVE=24h
